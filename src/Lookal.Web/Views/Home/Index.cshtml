@{
    ViewData["Title"] = "Nearby requests";
}

<div class="page-head">
    <div>
        <h1 class="page-title">Nearby requests</h1>
        <p class="page-sub">Open requests in Riverside Community, nearest first.</p>
    </div>
    <div class="select-like">Nearest first <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg></div>
</div>

<section class="banner" aria-label="Verification reminder">
    <span class="banner-icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg></span>
    <div class="banner-text">
        <strong>Verify your ID to accept requests.</strong>
        <span>You can browse requests while your ID is reviewed.</span>
    </div>
    <a class="button button-compact" asp-controller="Account" asp-action="VerifyId">Verify now</a>
</section>

<div class="chips">
    <a class="chip active" href="#">All</a>
    <a class="chip" href="#">Groceries</a>
    <a class="chip" href="#">Medicine</a>
    <a class="chip" href="#">Pickup</a>
    <a class="chip" href="#">Errands</a>
</div>

<section class="cards">
    <article class="card">
        <div class="card-top"><span class="tag">Medicine</span><span class="status">Open</span></div>
        <h2 class="card-title">Pick up prescription</h2>
        <p class="card-meta">0.8 km away · Due in 2 hours</p>
        <div class="card-foot">
            <div class="poster"><span class="poster-initials">AR</span><span>Ana R. · ★ 4.9 · 23 tasks</span></div>
            <div class="card-action"><span class="fee">₱50</span><a class="button-outline" href="#">View details</a></div>
        </div>
    </article>

    <article class="card">
        <div class="card-top"><span class="tag">Groceries</span><span class="status">Open</span></div>
        <h2 class="card-title">Grocery run</h2>
        <p class="card-meta">1.2 km away · Due tomorrow</p>
        <div class="card-foot">
            <div class="poster"><span class="poster-initials">MT</span><span>Mark T. · ★ 4.7 · 11 tasks</span></div>
            <div class="card-action"><span class="fee">₱120</span><a class="button-outline" href="#">View details</a></div>
        </div>
    </article>

    <article class="card">
        <div class="card-top"><span class="tag">Pickup</span><span class="status">Open</span></div>
        <h2 class="card-title">Collect parcel from post office</h2>
        <p class="card-meta">0.4 km away · Due in 3 hours</p>
        <div class="card-foot">
            <div class="poster"><span class="poster-initials">LC</span><span>Liza C. · ★ 5.0 · 8 tasks</span></div>
            <div class="card-action"><span class="fee">₱60</span><a class="button-outline" href="#">View details</a></div>
        </div>
    </article>

    <article class="card">
        <div class="card-top"><span class="tag">Errands</span><span class="status">Open</span></div>
        <h2 class="card-title">Drop off printed forms</h2>
        <p class="card-meta">2.1 km away · Due today, 6:00 PM</p>
        <div class="card-foot">
            <div class="poster"><span class="poster-initials">JP</span><span>Jun P. · ★ 4.8 · 35 tasks</span></div>
            <div class="card-action"><span class="fee">₱80</span><a class="button-outline" href="#">View details</a></div>
        </div>
    </article>
</section>