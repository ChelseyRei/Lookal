<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Lookal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar lookal-navbar">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand text-white fw-semibold m-0" asp-controller="Home" asp-action="Index">Lookal</a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-light">Log out</button>
                </form>
            }
            else
            {
                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-sm btn-light" asp-controller="Account" asp-action="Register">Register</a>
                </div>
            }
        </div>
    </nav>

    <main class="container py-4 lookal-main">
        @RenderBody()
    </main>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="lookal-bottom-nav d-md-none" aria-label="Main">
            <a class="active" asp-controller="Home" asp-action="Index">Home</a>
            <a class="disabled" aria-disabled="true">Post</a>
            <a class="disabled" aria-disabled="true">My tasks</a>
            <a class="disabled" aria-disabled="true">Profile</a>
        </nav>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>