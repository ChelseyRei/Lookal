<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Lookal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="~/images/lookal-icon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/lookal.css" asp-append-version="true" />
</head>
<body>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    string NavClass(string page) => (ViewData["NavActive"] as string) == page ? "active" : "";
}

@if (signedIn)
{
    <header class="topbar">
        <a class="logo" asp-controller="Home" asp-action="Index">
            <span class="logo-name">Lookal</span>
        </a>
        <nav class="nav-links" aria-label="Main">
            <a class="@NavClass("requests")" asp-controller="Home" asp-action="Index">Nearby requests</a>
            <a href="#">My requests</a>
            <a href="#">My tasks</a>
            <a class="@NavClass("profile")" asp-controller="Account" asp-action="Profile">Profile</a>
        </nav>
        <div class="topbar-actions">
            <a class="button button-primary button-compact" href="#">Post a request</a>
            <a class="avatar" asp-controller="Account" asp-action="Profile" aria-label="Your profile">MS</a>
        </div>
    </header>
}

<main class="lookal-main @(signedIn ? "page" : "container py-4")">
    @RenderBody()
</main>

@if (signedIn)
{
    <nav class="lookal-bottom-nav d-md-none" aria-label="Mobile">
        <a class="@NavClass("requests")" asp-controller="Home" asp-action="Index">Home</a>
        <a href="#">Post</a>
        <a href="#">My tasks</a>
        <a class="@NavClass("profile")" asp-controller="Account" asp-action="Profile">Profile</a>
    </nav>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>