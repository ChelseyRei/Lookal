@model Lookal.Web.ViewModels.VerifyOtpViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Enter your code";
}

@section Brand {
    <div class="brand-hero">
        <h1>Almost there</h1>
        <p>Enter the code we sent to your phone. Your account is saved once your number is confirmed.</p>
    </div>

    <ul class="brand-points">
        <li class="point">
            <span class="dot dot-done"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
            <div><strong>Your details</strong><span>Name, date of birth, and password</span></div>
        </li>
        <li class="point">
            <span class="dot dot-current">2</span>
            <div><strong>Confirm your number</strong><span>One-time code sent by SMS</span></div>
        </li>
        <li class="point point-todo">
            <span class="dot dot-todo">3</span>
            <div><strong>Your city</strong><span>Optional. You can skip this step</span></div>
        </li>
        <li class="point point-todo">
            <span class="dot dot-todo">4</span>
            <div><strong>Verify your ID</strong><span>Optional. Needed to accept tasks</span></div>
        </li>
    </ul>
}

<p class="step-count">Step 2 of 4</p>
<div class="steps" aria-hidden="true">
    <span class="done"></span><span class="current"></span><span></span><span></span>
</div>

<h2 class="title">Enter your code</h2>
<p class="subtitle">We sent a 6-digit code to your mobile number.</p>

@if (TempData["Status"] is string status)
{
    <p class="hint" role="status">@status</p>
}

<form asp-controller="Account" asp-action="VerifyOtp" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="field">
        <label asp-for="Code" class="label"></label>
        <input asp-for="Code" class="input input-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" />
        <span asp-validation-for="Code" class="hint text-danger"></span>
        @if (HostEnv.IsDevelopment())
        {
            <p class="hint">Development only: use code 123456.</p>
        }
    </div>

    <div class="form-actions">
        <button type="submit" class="button button-primary">Verify and continue</button>
    </div>
</form>

<form asp-controller="Account" asp-action="ResendCode" method="post" class="footnote">
    Didn't get a code? <button type="submit" class="link-button">Send a new code</button>
</form>